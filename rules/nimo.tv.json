{
  "domain": "nimo.tv",
  "label": "nimo.tv",
  "adaptedFrom": "PhotoShow 4.92.2 sites/nimo.tv.js",
  "note": "改编自 PhotoShow 的 srcRegExp/processor（仅取字符串型 processor；函数型未采用）；@IMG@ 已展开为标准扩展名集合；未逐站实测",
  "hd": [
    {
      "id": "ps-nimo.tv-1",
      "name": "原图还原",
      "loop": false,
      "steps": [
        [
          "(//.+?\\.nimo\\.tv/.+\\w+)_\\d+_\\d+((?:jpe?g|png|webp|gif|bmp|avif))",
          "",
          "$1$2"
        ]
      ]
    },
    {
      "id": "ps-nimo.tv-2",
      "name": "原图还原",
      "loop": false,
      "steps": [
        [
          "(//.+?\\.nimo\\.tv/.+\\w+(?:jpe?g|png|webp|gif|bmp|avif)/)\\w+(/img(?:jpe?g|png|webp|gif|bmp|avif))",
          "",
          "$1$2"
        ]
      ]
    }
  ],
  "clean": []
}
