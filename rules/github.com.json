{
  "domain": "github.com",
  "label": "github.com",
  "adaptedFrom": "PhotoShow 4.92.2 sites/github.com.js",
  "note": "改编自 PhotoShow 的 srcRegExp/processor（仅取字符串型 processor；函数型未采用）；@IMG@ 已展开为标准扩展名集合；未逐站实测",
  "hd": [
    {
      "id": "ps-github.com-1",
      "name": "原图还原",
      "loop": false,
      "steps": [
        [
          "//github\\.com/(.+/)(?:blob|raw)/(.+(?:jpe?g|png|webp|gif|bmp|avif)).*",
          "",
          "//raw.githubusercontent.com/$1$2"
        ]
      ]
    },
    {
      "id": "ps-github.com-2",
      "name": "原图还原",
      "loop": false,
      "steps": [
        [
          "(//(?:avatars\\d*|marketplace-screenshots)\\.githubusercontent\\.com/[^?]+).*",
          "",
          "$1"
        ]
      ]
    }
  ],
  "clean": []
}
