{
  "domain": "artstation.com",
  "label": "artstation.com",
  "adaptedFrom": "PhotoShow 4.92.2 sites/artstation.com.js",
  "note": "改编自 PhotoShow 的 srcRegExp/processor（仅取字符串型 processor；函数型未采用）；@IMG@ 已展开为标准扩展名集合；未逐站实测",
  "hd": [
    {
      "id": "ps-artstation.com-1",
      "name": "原图还原",
      "loop": false,
      "steps": [
        [
          "(//cdn\\w?\\.artstation\\.com/p/users/covers/.+/)small(/.+(?:jpe?g|png|webp|gif|bmp|avif).*)",
          "",
          "$1default$2"
        ]
      ]
    },
    {
      "id": "ps-artstation.com-2",
      "name": "原图还原",
      "loop": false,
      "steps": [
        [
          "(//cdn\\w?\\.artstation\\.com/p/marketplace/.+/.+_)small(/.+(?:jpe?g|png|webp|gif|bmp|avif).*)",
          "",
          "$1big$2"
        ]
      ]
    },
    {
      "id": "ps-artstation.com-3",
      "name": "原图还原",
      "loop": false,
      "steps": [
        [
          "(//cdn\\w?\\.artstation\\.com/.+?/)(?:\\d{14}/)?(?:medium|\\w+_square|thumbnail)(/.+(?:jpe?g|png|webp|gif|bmp|avif).*)",
          "",
          "$1large$2"
        ]
      ]
    }
  ],
  "clean": []
}
