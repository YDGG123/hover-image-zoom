{
  "domain": "discord.com",
  "label": "discord.com",
  "adaptedFrom": "PhotoShow 4.92.2 sites/discord.com.js",
  "note": "改编自 PhotoShow 的 srcRegExp/processor（仅取字符串型 processor；函数型未采用）；@IMG@ 已展开为标准扩展名集合；未逐站实测",
  "hd": [
    {
      "id": "ps-discord.com-1",
      "name": "原图还原",
      "loop": false,
      "steps": [
        [
          "(//.+(?:jpe?g|png|webp|gif|bmp|avif)\\?.*&?size=).*",
          "",
          "$14096&keep_aspect_ratio=true"
        ]
      ]
    },
    {
      "id": "ps-discord.com-2",
      "name": "原图还原",
      "loop": false,
      "steps": [
        [
          "(//.+/attachments/.+\\?.*?)(?:&?(?:format|height|quality|width)=[^&]*)+(.*)",
          "",
          "$1$2"
        ]
      ]
    }
  ],
  "clean": []
}
